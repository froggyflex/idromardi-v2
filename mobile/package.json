{
  "name": "idromardi-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:internal": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:testflight": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "build:stores": "npx eas-cli@latest build --platform all --profile production"
  },
  "dependencies": {
    "expo": "~57.0.14",
    "expo-crypto": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
