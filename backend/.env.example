PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=idromardi
DB_PASSWORD=change-me
DB_NAME=miteamx1_fatturazione

# Required outside local development. Use a long, random value.
AUTH_TOKEN_SECRET=change-me-with-at-least-32-random-characters

# Required only when a production database does not yet contain an admin user.
INITIAL_ADMIN_PASSWORD=change-this-immediately

# Optional private Cloudflare R2 storage for mobile meter photos.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Meta credentials belong only on the backend. Never commit real secrets.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_CREDENTIALS_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0
META_OUTBOX_WORKER_ENABLED=false
META_OUTBOX_INTERVAL_MS=5000
META_GRAPH_TIMEOUT_MS=15000
RUN_META_MIGRATION_ON_STARTUP=true
# Separate Instagram Login app, NOT the main Meta app or Instagram account ID.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
